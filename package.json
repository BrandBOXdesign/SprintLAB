{
  "name": "sprint-lab",
  "version": "1.0.0",
  "description": "Sprint Lab - app de entrenamiento de velocidad",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "verify:skeleton": "node scripts/verify-skeleton.mjs",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.47.0"
  },
  "build": {
    "appId": "com.sprintlab.app",
    "productName": "Sprint Lab",
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icons/sprint_lab.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
